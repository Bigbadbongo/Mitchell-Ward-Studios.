  file_change {
    absolute_path_uri: "file:///src/components/ShoppingBasketDrawer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { BasketItem } from \"../types\";\nimport { X, Trash2, ShoppingBasket, Sparkles, Check } from \"lucide-react\";\n\ninterface ShoppingBasketDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  items: BasketItem[];\n  onRemoveItem: (id: string) => void;\n  onClearBasket: () => void;\n}\n\nexport default function ShoppingBasketDrawer({\n  isOpen,\n  onClose,\n  items,\n  onRemoveItem,\n  onClearBasket,\n}: ShoppingBasketDrawerProps) {\n  const [checkoutStep, setCheckoutStep] = useState<\"cart\" | \"submitting\" | \"confirmed\">(\"cart\");\n  const [shippingAddress, setShippingAddress] = useState({\n    name: \"Mitch Gallery\",\n    email: \"mitch363@gmail.com\",\n    address: \"125 Pall Mall, London, UK\",\n  });\n\n  if (!isOpen) return null;\n\n  // Pricing math\n  const subtotal = items.reduce((acc, curr) => acc + curr.price, 0);\n  const packagingFee = items.length * 15; // 15$ premium crate packaging per artwork\n  const shippingFee = subtotal > 500 ? 0 : 35; // Free over 500$\n  const total = subtotal + packagingFee + shippingFee;\n\n  const handleCheckout = () => {\n    setCheckoutStep(\"submitting\");\n    setTimeout(() => {\n      setCheckoutStep(\"confirmed\");\n    }, 1800);\n  };\n\n  const handleReset = () => {\n    onClearBasket();\n    setCheckoutStep(\"cart\");\n    onClose();\n  };\n\n  return (\n    <div className=\"absolute inset-0 bg-slate-950/70 backdrop-blur-xs flex justify-end z-50 overflow-hidden font-sans\">\n      {/* Drawer bounds (fits inside simulated mobile viewpoint viewport gracefully) */}\n      <div className=\"w-[88%] bg-[#FAF9F6] h-full flex flex-col shadow-2xl animate-in slide-in-from-right duration-300\">\n        \n        {/* Header */}\n        <div className=\"p-4 border-b border-stone-200/60 flex items-center justify-between bg-white\">\n          <div className=\"flex items-center gap-2\">\n            <ShoppingBasket className=\"w-5 h-5 text-[#6A0DAD]\" />\n            <span className=\"font-semibold text-slate-800 text-sm tracking-tight\">SHOPPING BAG</span>\n            {items.length > 0 && (\n              <span className=\"bg-[#6A0DAD] text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold\">\n                {items.length}\n              </span>\n            )}\n          </div>\n          <button\n            id=\"close-basket-drawer\"\n            onClick={onClose}\n            className=\"p-1.5 rounded-full hover:bg-stone-100 text-slate-400 hover:text-slate-800 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {checkoutStep === \"cart\" && (\n          <>\n            {/* Basket Items List */}\n            <div className=\"flex-1 overflow-y-auto p-4 space-y-3\">\n              {items.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center p-6 text-center text-slate-400\">\n                  <div className=\"w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mb-4\">\n                    <ShoppingBasket className=\"w-8 h-8 text-stone-300\" />\n                  </div>\n                  <h3 className=\"text-sm font-medium text-slate-700 font-sans\">Your basket is empty</h3>\n                  <p className=\"text-xs text-slate-400 mt-1 max-w-[200px]\">Browse our fine art portfolios and configure custom shadowbox frames.</p>\n                </div>\n              ) : (\n                items.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"bg-white p-3 rounded-xl border border-stone-200/50 flex gap-3 shadow-xs animate-in fade-in duration-200\"\n                  >\n                    {/* Tiny representation placeholder */}\n                    <div className=\"w-12 h-12 rounded bg-stone-100 border border-stone-200/60 flex items-center justify-center flex-shrink-0 overflow-hidden relative\">\n                      {/* Drawing representation colored background indicator */}\n                      <div \n                        className=\"w-full h-full opacity-70\"\n                        style={{\n                          background: `linear-gradient(135deg, ${item.artwork.primaryColor}, ${item.artwork.secondaryColor}, ${item.artwork.tertiaryColor})`\n                        }}\n                      />\n                      <div className=\"absolute inset-0 flex items-center justify-center text-[8px] font-mono select-none font-bold text-slate-800 bg-white/30 backdrop-blur-xxs\">\n                        {item.artwork.category[0]}\n                      </div>\n                    </div>\n\n                    {/* Meta info */}\n                    <div className=\"flex-1 min-w-0\">\n                      <h4 className=\"font-medium text-xs text-slate-800 truncate\">{item.artwork.title}</h4>\n                      <p className=\"text-[10px] text-slate-500 font-mono tracking-tight mt-0.5 uppercase\">\n                        {item.artwork.style} \342\200\242 {item.artwork.size}\n                      </p>\n                      \n                      {/* Frame option indicator badge */}\n                      <div className=\"mt-1 flex items-center gap-1.5\">\n                        <span className=\"text-[9px] bg-stone-100 text-slate-600 px-1.5 py-0.5 rounded font-mono border border-stone-200/60\">\n                          Frame: <span className=\"font-semibold text-[#6A0DAD]\">{item.frame}</span>\n                        </span>\n                      </div>\n                    </div>\n\n                    {/* Price and trash */}\n                    <div className=\"flex flex-col items-end justify-between\">\n                      <span className=\"text-xs font-semibold text-slate-900 font-mono\">${item.price}</span>\n                      <button\n                        id={`remove-item-${item.id}`}\n                        onClick={() => onRemoveItem(item.id)}\n                        className=\"p-1 rounded text-red-400 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                        title=\"Delete item\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n\n            {/* Price Calculations and Checker Footer */}\n            {items.length > 0 && (\n              <div className=\"p-4 bg-white border-t border-stone-200/80 space-y-3.5\">\n                <div className=\"space-y-1.5 text-xs text-slate-500 font-mono\">\n                  <div className=\"flex justify-between\">\n                    <span>Subtotal:</span>\n                    <span className=\"text-slate-800 font-semibold\">${subtotal}</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span>Premium Crate Pkg:</span>\n                    <span className=\"text-slate-800 font-semibold\">${packagingFee}</span>\n                  </div>\n                  <div className=\"flex justify-between\">\n                    <span>Insured Courier:</span>\n                    <span className=\"text-slate-800 font-semibold\">\n                      {shippingFee === 0 ? <span className=\"text-emerald-600\">FREE</span> : `$${shippingFee}`}\n                    </span>\n                  </div>\n                  <div className=\"border-t border-stone-100 my-2 pt-2 flex justify-between text-sm font-semibold text-slate-800 font-sans\">\n                    <span className=\"tracking-tight text-slate-900\">Total Valuation:</span>\n                    <span className=\"text-[#6A0DAD] font-mono\">${total}</span>\n                  </div>\n                </div>\n\n                {/* Checkout simulation Trigger */}\n                <button\n                  id=\"checkout-trigger\"\n                  onClick={handleCheckout}\n                  className=\"w-full bg-[#6A0DAD] text-white py-3 rounded-xl font-semibold tracking-wide hover:bg-[#5C0A96] active:scale-98 transition-all shadow-md flex items-center justify-center gap-2 text-xs\"\n                >\n                  <Sparkles className=\"w-4 h-4 animate-spin-slow\" />\n                  CONFIRM COMMISSION\n                </button>\n              </div>\n            )}\n          </>\n        )}\n\n        {checkoutStep === \"submitting\" && (\n          <div className=\"flex-1 flex flex-col items-center justify-center p-6 text-center bg-white\">\n            <div className=\"w-14 h-14 border-4 border-t-[#6A0DAD] border-[#6A0DAD]/20 rounded-full animate-spin mb-4\" />\n            <h3 className=\"text-sm font-semibold text-slate-800\">Drafting Studio Ticket...</h3>\n            <p className=\"text-xs text-slate-500 mt-2 max-w-[200px]\">Securing museum materials, preparing physical frame stretchers.</p>\n          </div>\n        )}\n\n        {checkoutStep === \"confirmed\" && (\n          <div className=\"flex-1 flex flex-col items-center justify-center p-6 text-center animate-in zoom-in-95 duration-300\">\n            <div className=\"w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mb-4 text-emerald-600 shadow-sm\">\n              <Check className=\"w-8 h-8\" />\n            </div>\n            <h3 className=\"text-sm font-bold text-slate-800\">COMMISSION RESERVED</h3>\n            <p className=\"text-xs text-slate-500 mt-2 max-w-[220px]\">\n              Studio Ticket <span className=\"font-mono text-[#6A0DAD] font-bold\">#ART-2026</span> was locked in under <span className=\"font-semibold text-slate-700\">{shippingAddress.email}</span>.\n            </p>\n            \n            <div className=\"bg-stone-50 p-3 rounded-xl border border-stone-100 text-[10px] text-left text-slate-500 mt-4 w-full\">\n              <span className=\"font-semibold uppercase text-slate-800 block mb-1\">COURIER DISPATCH ADDRESS:</span>\n              <p className=\"font-mono\">{shippingAddress.name}</p>\n              <p className=\"font-mono\">{shippingAddress.address}</p>\n            </div>\n\n            <button\n              id=\"checkout-done-reset\"\n              onClick={handleReset}\n              className=\"mt-6 w-full bg-slate-950 text-white py-2.5 rounded-xl font-semibold hover:bg-slate-800 transition-colors text-xs\"\n            >\n              RETURN TO GALLERY\n            </button>\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n}\n"
    }
