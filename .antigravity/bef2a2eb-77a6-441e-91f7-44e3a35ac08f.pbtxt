    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Artwork, FrameType, BasketItem, ArtCategory, ArtStyle } from \"./types\";\nimport { GALLERY_ARTWORKS } from \"./data\";\nimport ThreeDFrameMockup from \"./components/ThreeDFrameMockup\";\nimport ShoppingBasketDrawer from \"./components/ShoppingBasketDrawer\";\nimport UserStoriesModal from \"./components/UserStoriesModal\";\nimport { \n  ArrowLeft, \n  ShoppingBasket, \n  Instagram, \n  User, \n  Sparkles, \n  ChevronRight, \n  Plus, \n  Check, \n  Loader2, \n  CircleAlert,\n  Info\n} from \"lucide-react\";\n\nexport default function App() {\n  // Navigation & Menu hierarchy state\n  // \"main\" -> \"paintings-submenu\" | \"photography-submenu\" -> \"artwork-list\" -> \"artwork-detail\"\n  const [menuState, setMenuState] = useState<\"main\" | \"paintings-submenu\" | \"photography-submenu\" | \"artwork-list\" | \"artwork-detail\">(\"main\");\n  const [selectedSubCategory, setSelectedSubCategory] = useState<ArtStyle | null>(null);\n  const [selectedArtwork, setSelectedArtwork] = useState<Artwork | null>(null);\n  const [chosenFrame, setChosenFrame] = useState<FrameType>(\"Oak\");\n\n  // Shopping Basket State\n  const [basket, setBasket] = useState<BasketItem[]>([]);\n  const [isBasketOpen, setIsBasketOpen] = useState<boolean>(false);\n\n  // Stories Modal State\n  const [isStoriesOpen, setIsStoriesOpen] = useState<boolean>(false);\n\n  // AI Curation Loading overlay state (Surprise Me!)\n  const [isCurating, setIsCurating] = useState<boolean>(false);\n  const [curationNote, setCurationNote] = useState<string>(\"Securing canvas materials...\");\n  const [instagramNotice, setInstagramNotice] = useState<boolean>(false);\n\n  // Local storage persistence of the shopping basket\n  useEffect(() => {\n    try {\n      const cached = localStorage.getItem(\"art_gallery_basket\");\n      if (cached) {\n        setBasket(JSON.parse(cached));\n      }\n    } catch (e) {\n      console.error(\"Failed to load shopping basket from cache:\", e);\n    }\n  }, []);\n\n  const saveBasket = (updated: BasketItem[]) => {\n    setBasket(updated);\n    try {\n      localStorage.setItem(\"art_gallery_basket\", JSON.stringify(updated));\n    } catch (e) {\n      console.error(\"Failed to persist shopping basket:\", e);\n    }\n  };\n\n  // Curating animation steps\n  useEffect(() => {\n    if (!isCurating) return;\n    const notes = [\n      \"Consulting AI Studio curatorial archives...\",\n      \"Matching natural organic pigment palettes...\",\n      \"Sourcing kiln-dried travertine plaster formulas...\",\n      \"Drafting dimensional cotton canvas wrap coordinates...\",\n      \"Securing gold leaf flake offsets...\",\n      \"Structuring gallery shadowbox specs...\"\n    ];\n    let step = 0;\n    const interval = setInterval(() => {\n      if (step < notes.length) {\n        setCurationNote(notes[step]);\n        step++;\n      }\n    }, 800);\n    return () => clearInterval(interval);\n  }, [isCurating]);\n\n  // Handler for adding items to the basket\n  const handleAddToBasket = (artwork: Artwork, frame: FrameType) => {\n    const newItem: BasketItem = {\n      id: `basket-item-${Date.now()}-${Math.random()}`,\n      artwork,\n      frame,\n      price: artwork.price,\n    };\n    const updated = [...basket, newItem];\n    saveBasket(updated);\n    \n    // Auto trigger open the basket drawer to show confirmation feedback\n    setIsBasketOpen(true);\n  };\n\n  // Remove basket item\n  const handleRemoveItem = (id: string) => {\n    const updated = basket.filter((item) => item.id !== id);\n    saveBasket(updated);\n  };\n\n  // Clear basket\n  const handleClearBasket = () => {\n    saveBasket([]);\n  };\n\n  // Trigger server-side AI curation (Surprise Me)\n  const handleSurpriseMe = async () => {\n    setIsCurating(true);\n    setCurationNote(\"Consulting AI Studio curatorial archives...\");\n\n    const moods = [\n      \"Warm Mid-Century Solitude\",\n      \"Liquid Cobalt Sands\",\n      \"Stygian Nebula Whisp\",\n      \"Quiet Botanical Sage\",\n      \"Earthy Travertine Brutalism\",\n      \"Acid Neon Shibuya Velocity\"\n    ];\n    const pickedMood = moods[Math.floor(Math.random() * moods.length)];\n\n    try {\n      const response = await fetch(\"/api/curate-artwork\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ mood: pickedMood }),\n      });\n      const data = await response.json();\n\n      if (data && data.artwork) {\n        // Construct a stylized Artwork object from Gemini response\n        const generated: Artwork = {\n          id: `ai-curr-${Date.now()}`,\n          title: data.artwork.title || \"Luminous Echo\",\n          artist: \"AI Studio Curator\",\n          description: data.artwork.description || \"A breathtaking original abstract composition generated in real-time by the server-side Gemini neural model.\",\n          medium: data.artwork.medium || \"Acrylic Pigment and Gesso Strata on Raw Canvas\",\n          size: \"12 x 12 in\",\n          price: data.artwork.price || 420,\n          category: \"Paintings\",\n          style: \"AI\",\n          primaryColor: data.artwork.primaryColor || \"#D97706\",\n          secondaryColor: data.artwork.secondaryColor || \"#FBBF24\",\n          tertiaryColor: data.artwork.tertiaryColor || \"#ECEAE2\",\n          visualType: data.artwork.visualType || \"minimalist\",\n          imageSeed: `ai-gen-${Date.now()}`\n        };\n\n        setSelectedArtwork(generated);\n        setChosenFrame(data.artwork.framePreference || \"Oak\");\n        setMenuState(\"artwork-detail\");\n      }\n    } catch (err) {\n      console.error(\"AI Curation error, failing back safely:\", err);\n    } finally {\n      setIsCurating(false);\n    }\n  };\n\n  // Filter artworks list based on active category / subcategory\n  const getFilteredArtworks = () => {\n    if (!selectedSubCategory) return [];\n    return GALLERY_ARTWORKS.filter((art) => art.style === selectedSubCategory);\n  };\n\n  return (\n    <div id=\"app-root\" className=\"min-h-screen bg-stone-100 flex items-center justify-center py-6 px-4 selection:bg-[#6A0DAD] selection:text-white relative overflow-hidden\">\n      \n      {/* Absolute Decorative background elements on larger viewports */}\n      <div className=\"absolute top-10 left-10 w-48 h-48 rounded-full bg-gradient-to-tr from-[#6A0DAD]/10 to-transparent blur-3xl pointer-events-none hidden md:block\" />\n      <div className=\"absolute bottom-10 right-10 w-72 h-72 rounded-full bg-gradient-to-tr from-amber-500/5 to-transparent blur-3xl pointer-events-none hidden md:block\" />\n      <div className=\"absolute top-[40%] right-[10%] w-36 h-36 rounded-full bg-indigo-500/5 blur-3xl pointer-events-none hidden md:block\" />\n\n      {/* 2-5 Header label on wider viewports */}\n      <div className=\"absolute top-8 left-1/2 -translate-x-1/2 text-center pointer-events-none hidden lg:block select-none\">\n        <h1 className=\"text-xl font-light tracking-[0.25em] text-slate-400 font-sans uppercase\">\n          Studio Canvas\n        </h1>\n        <p className=\"text-[10px] font-mono text-slate-300 uppercase mt-1 tracking-wider\">\n          Mobile Art Exhibition & framing simulation\n        </p>\n      </div>\n\n      {/* --- PHONE DEVICE CASING SHELL --- */}\n      <div \n        id=\"phone-frame-container\"\n        className=\"w-full max-w-[410px] h-[840px] bg-[#FAF9F6] shadow-[0_25px_60px_-15px_rgba(0,0,0,0.3)] md:rounded-[44px] md:border-[12px] md:border-slate-900 border-none flex flex-col justify-between overflow-hidden relative\"\n      >\n        {/* Phone Speaker & Camera Bezel Notch simulation */}\n        <div className=\"absolute top-0 left-1/2 -translate-x-1/2 w-32 h-6 bg-slate-950 rounded-b-xl z-40 flex items-center justify-center gap-1.5 hidden md:flex\">\n          {/* Speaker bar */}\n          <div className=\"w-10 h-1 bg-stone-800 rounded-full\" />\n          {/* Camera lens */}\n          <div className=\"w-2.5 h-2.5 bg-sky-950 rounded-full border border-stone-800\" />\n        </div>\n\n        {/* --- MAIN HEADER NAVIGATION BAR --- */}\n        <header className=\"pt-8 pb-4 px-6 border-b border-stone-200/50 flex items-center justify-between bg-white/80 backdrop-blur z-20\">\n          {menuState !== \"main\" ? (\n            <button\n              id=\"back-navigation-btn\"\n              onClick={() => {\n                if (menuState === \"paintings-submenu\" || menuState === \"photography-submenu\") {\n                  setMenuState(\"main\");\n                } else if (menuState === \"artwork-list\") {\n                  setMenuState(selectedArtwork?.category === \"Paintings\" ? \"paintings-submenu\" : \"photography-submenu\");\n                } else if (menuState === \"artwork-detail\") {\n                  // If it\'s the AI curated surprise me, go back to main menu\n                  if (selectedArtwork?.style === \"AI\") {\n                    setMenuState(\"main\");\n                  } else {\n                    setMenuState(\"artwork-list\");\n                  }\n                }\n              }}\n              className=\"p-1.5 rounded-full hover:bg-stone-50 text-slate-600 hover:text-slate-900 transition-colors flex items-center justify-center\"\n              aria-label=\"Go Back\"\n            >\n              <ArrowLeft className=\"w-5 h-5\" />\n            </button>\n          ) : (\n            <div className=\"w-8 h-8 flex items-center justify-center\">\n              <span className=\"text-xs uppercase font-mono tracking-widest text-[#6A0DAD] font-extrabold border border-[#6A0DAD] px-1.5 py-0.5 rounded-xs\">SC</span>\n            </div>\n          )}\n\n          {/* Title changes contextually */}\n          <div className=\"text-center flex-1\">\n            <h2 className=\"text-xs font-bold uppercase tracking-[0.2em] text-slate-800 font-sans truncate\">\n              {menuState === \"main\" && \"Studio Canvas\"}\n              {menuState === \"paintings-submenu\" && \"Fine Paintings\"}\n              {menuState === \"photography-submenu\" && \"Art Photography\"}\n              {menuState === \"artwork-list\" && selectedSubCategory}\n              {menuState === \"artwork-detail\" && (selectedArtwork?.title || \"EXHIBIT\")}\n            </h2>\n            <span className=\"text-[8px] font-mono tracking-widest uppercase text-slate-400 block mt-0.5\">\n              {menuState === \"main\" && \"EST. 2026\"}\n              {menuState === \"paintings-submenu\" && \"Ochre & Gesso\"}\n              {menuState === \"photography-submenu\" && \"Silver Gelatin\"}\n              {menuState === \"artwork-list\" && \"Exhibition Roll\"}\n              {menuState === \"artwork-detail\" && (selectedArtwork?.artist || \"curated\")}\n            </span>\n          </div>\n\n          <div className=\"relative\">\n            <button\n              id=\"header-basket-trigger\"\n              onClick={() => setIsBasketOpen(true)}\n              className=\"p-2 rounded-full hover:bg-stone-50 text-slate-700 transition-all relative\"\n            >\n              <ShoppingBasket className=\"w-4.5 h-4.5\" />\n              {basket.length > 0 && (\n                <span className=\"absolute -top-1 -right-0.5 bg-[#6A0DAD] text-white text-[9px] w-4.5 h-4.5 rounded-full flex items-center justify-center font-bold border border-[#FAF9F6]\">\n                  {basket.length}\n                </span>\n              )}\n            </button>\n          </div>\n        </header>\n\n        {/* --- MAIN PAGE VIEWPORT SCROLLABLE BODY --- */}\n        <main className=\"flex-1 overflow-y-auto px-6 py-4 flex flex-col justify-start relative bg-[#FAF9F6]\">\n          \n          {/* STATIC DECORATIVE STRIPES BACKGROUND (HAND-MADE LOOK) */}\n          <div className=\"absolute inset-0 pointer-events-none opacity-[0.03] bg-radial-grid pattern-grid\" />\n\n          {/* PAGE A: MAIN START MENU VIEW */}\n          {menuState === \"main\" && (\n            <div className=\"flex-1 flex flex-col justify-center space-y-7 py-4\">\n              \n              {/* Introduction header card */}\n              <div className=\"text-center space-y-2 mb-2 animate-in fade-in slide-in-from-top duration-300\">\n                <span className=\"text-[10px] bg-amber-100 text-[#CD9662] px-2.5 py-0.5 rounded-full font-bold tracking-widest font-mono select-none uppercase\">\n                  Collector Portfolio\n                </span>\n                <p className=\"text-stone-500 text-xs max-w-[280px] mx-auto leading-relaxed\">\n                  Browse fine physical paintings or luxury photographic emulsions. Frame them instantly inside floating carpentry mockups.\n                </p>\n              </div>\n\n              {/* STACK OF THREE UNIFORM EXQUISITE SQUARE BUTTONS */}\n              <div className=\"space-y-6 w-full max-w-[280px] mx-auto\">\n                \n                {/* BUTTON 1: \342\234\250 SURPRISE ME! */}\n                <button\n                  id=\"btn-surprise\"\n                  onClick={handleSurpriseMe}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all rounded-xs focus:outline-none flex flex-col items-center justify-center p-3 text-center\"\n                >\n                  {/* Sketched overlay */}\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-2\">\n                    <Sparkles className=\"w-7 h-7 text-amber-500 animate-spin-slow group-hover:scale-110 transition-transform\" />\n                    <span className=\"font-sans font-black text-sm tracking-widest text-[#6A0DAD] group-hover:tracking-[0.15em] transition-all duration-300\">\n                      \342\234\250 SURPRISE ME!\n                    </span>\n                    <span className=\"text-[8px] font-mono tracking-widest text-slate-400 uppercase mt-0.5\">\n                      Gemini AI Curation\n                    </span>\n                  </div>\n                </button>\n\n                {/* BUTTON 2: \360\237\216\250 PAINTINGS */}\n                <button\n                  id=\"btn-paintings\"\n                  onClick={() => setMenuState(\"paintings-submenu\")}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all rounded-xs focus:outline-none flex flex-col items-center justify-center p-3 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-2\">\n                    <div className=\"w-10 h-10 rounded-full bg-[#6A0DAD]/5 flex items-center justify-center group-hover:bg-[#6A0DAD]/10 transition-colors\">\n                      <span className=\"text-xl\">\360\237\216\250</span>\n                    </div>\n                    <span className=\"font-sans font-black text-sm tracking-widest text-[#6A0DAD] group-hover:tracking-[0.14em] transition-all duration-300\">\n                      PAINTINGS\n                    </span>\n                    <span className=\"text-[8px] font-mono tracking-widest text-slate-400 uppercase mt-0.5\">\n                      Oils \342\200\242 Minerals \342\200\242 Plaster\n                    </span>\n                  </div>\n                </button>\n\n                {/* BUTTON 3: \360\237\223\267 PHOTOGRAPHY */}\n                <button\n                  id=\"btn-photography\"\n                  onClick={() => setMenuState(\"photography-submenu\")}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all rounded-xs focus:outline-none flex flex-col items-center justify-center p-3 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-2\">\n                    <div className=\"w-10 h-10 rounded-full bg-[#6A0DAD]/5 flex items-center justify-center group-hover:bg-[#6A0DAD]/10 transition-colors\">\n                      <span className=\"text-xl\">\360\237\223\267</span>\n                    </div>\n                    <span className=\"font-sans font-black text-sm tracking-widest text-[#6A0DAD] group-hover:tracking-[0.14em] transition-all duration-300\">\n                      PHOTOGRAPHY\n                    </span>\n                    <span className=\"text-[8px] font-mono tracking-widest text-slate-400 uppercase mt-0.5\">\n                      Monochrome \342\200\242 Chromaluxe\n                    </span>\n                  </div>\n                </button>\n\n              </div>\n\n            </div>\n          )}\n\n          {/* PAGE B: PAINTINGS SUB-MENU WINDOW */}\n          {menuState === \"paintings-submenu\" && (\n            <div className=\"flex-1 flex flex-col justify-center space-y-6 py-4 max-w-[280px] mx-auto w-full\">\n              \n              <div className=\"text-center space-y-1 mb-2\">\n                <span className=\"text-[9px] font-mono text-[#6A0DAD] tracking-widest font-bold block uppercase\">\n                  CHOOSE CANVAS DIMENSION\n                </span>\n                <p className=\"text-[10px] text-slate-400\">\n                  Select a frame scale suitable for your collection.\n                </p>\n              </div>\n\n              {/* Submenu square stack: Mini, Studio, Statement */}\n              <div className=\"space-y-6\">\n                \n                {/* 1. Mini */}\n                <button\n                  id=\"btn-sub-mini\"\n                  onClick={() => {\n                    setSelectedSubCategory(\"Mini\");\n                    setMenuState(\"artwork-list\");\n                  }}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all flex flex-col items-center justify-center p-4 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-1.5\">\n                    <span className=\"text-xs uppercase tracking-widest font-mono text-[#6A0DAD]\">\n                      FORMAT-I\n                    </span>\n                    <h3 className=\"font-black text-slate-800 text-sm tracking-wide\">\n                      MINI PORTFOLIOS\n                    </h3>\n                    <p className=\"text-[9px] text-slate-400 max-w-[190px] leading-tight\">\n                      Precious, intimate 5x5\\\" or 6x6\\\" panels built for curated workspaces.\n                    </p>\n                    <span className=\"text-[10px] font-semibold text-[#6A0DAD] mt-1 font-mono\">From $180</span>\n                  </div>\n                </button>\n\n                {/* 2. Studio */}\n                <button\n                  id=\"btn-sub-studio\"\n                  onClick={() => {\n                    setSelectedSubCategory(\"Studio\");\n                    setMenuState(\"artwork-list\");\n                  }}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all flex flex-col items-center justify-center p-4 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-1.5\">\n                    <span className=\"text-xs uppercase tracking-widest font-mono text-[#6A0DAD]\">\n                      FORMAT-II\n                    </span>\n                    <h3 className=\"font-black text-slate-800 text-sm tracking-wide\">\n                      STUDIO CANVASES\n                    </h3>\n                    <p className=\"text-[9px] text-slate-400 max-w-[190px] leading-tight\">\n                      Expressive 10x10\\\" or 12x12\\\" panels tailored for balanced study rooms.\n                    </p>\n                    <span className=\"text-[10px] font-semibold text-[#6A0DAD] mt-1 font-mono\">From $450</span>\n                  </div>\n                </button>\n\n                {/* 3. Statement */}\n                <button\n                  id=\"btn-sub-statement\"\n                  onClick={() => {\n                    setSelectedSubCategory(\"Statement\");\n                    setMenuState(\"artwork-list\");\n                  }}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all flex flex-col items-center justify-center p-4 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-1.5\">\n                    <span className=\"text-xs uppercase tracking-widest font-mono text-[#6A0DAD]\">\n                      FORMAT-III\n                    </span>\n                    <h3 className=\"font-black text-slate-800 text-sm tracking-wide\">\n                      STATEMENT MONOLITHS\n                    </h3>\n                    <p className=\"text-[9px] text-slate-400 max-w-[190px] leading-tight\">\n                      Commanding 36x36\\\" or 40x40\\\" signature works made to anchor spaces.\n                    </p>\n                    <span className=\"text-[10px] font-semibold text-[#6A0DAD] mt-1 font-mono\">From $1450</span>\n                  </div>\n                </button>\n\n              </div>\n\n            </div>\n          )}\n\n          {/* PAGE C: PHOTOGRAPHY SUB-MENU WINDOW */}\n          {menuState === \"photography-submenu\" && (\n            <div className=\"flex-1 flex flex-col justify-center space-y-6 py-4 max-w-[280px] mx-auto w-full\">\n              \n              <div className=\"text-center space-y-1 mb-2\">\n                <span className=\"text-[9px] font-mono text-[#6A0DAD] tracking-widest font-bold block uppercase\">\n                  CHOOSE THEMATIC COLLECTION\n                </span>\n                <p className=\"text-[10px] text-slate-400\">\n                  Select an archival series printed on Baryta paper.\n                </p>\n              </div>\n\n              {/* Submenu square stack: Nature, Urban */}\n              <div className=\"space-y-6\">\n                \n                {/* 1. Nature/Landscapes */}\n                <button\n                  id=\"btn-sub-nature\"\n                  onClick={() => {\n                    setSelectedSubCategory(\"Nature/Landscapes\");\n                    setMenuState(\"artwork-list\");\n                  }}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all flex flex-col items-center justify-center p-4 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-1.5\">\n                    <span className=\"text-xs uppercase tracking-widest font-mono text-[#6A0DAD]\">\n                      SERIES-IV\n                    </span>\n                    <h3 className=\"font-black text-slate-800 text-sm tracking-wide\">\n                      NATURE & LANDSCAPES\n                    </h3>\n                    <p className=\"text-[9px] text-slate-400 max-w-[190px] leading-tight\">\n                      Contemplative basalt sand dunes and mist-shrouded mountain peaks.\n                    </p>\n                    <span className=\"text-[10px] font-semibold text-[#6A0DAD] mt-1 font-mono\">From $280</span>\n                  </div>\n                </button>\n\n                {/* 2. Urban/Culture */}\n                <button\n                  id=\"btn-sub-urban\"\n                  onClick={() => {\n                    setSelectedSubCategory(\"Urban/Culture\");\n                    setMenuState(\"artwork-list\");\n                  }}\n                  className=\"w-full aspect-square bg-white relative group active:scale-97 transition-all flex flex-col items-center justify-center p-4 text-center\"\n                >\n                  <HandDrawnBorder />\n                  <div className=\"z-10 flex flex-col items-center gap-1.5\">\n                    <span className=\"text-xs uppercase tracking-widest font-mono text-[#6A0DAD]\">\n                      SERIES-V\n                    </span>\n                    <h3 className=\"font-black text-slate-800 text-sm tracking-wide\">\n                      URBAN & CULTURE\n                    </h3>\n                    <p className=\"text-[9px] text-slate-400 max-w-[190px] leading-tight\">\n                      Wet rainy stone pavement reflections and streak-light velocity of cities.\n                    </p>\n                    <span className=\"text-[10px] font-semibold text-[#6A0DAD] mt-1 font-mono\">From $260</span>\n                  </div>\n                </button>\n\n              </div>\n\n            </div>\n          )}\n\n          {/* PAGE D: ARTWORKS SELECTION LIST */}\n          {menuState === \"artwork-list\" && (\n            <div className=\"space-y-4 py-2 animate-in fade-in slide-in-from-bottom duration-300\">\n              \n              <div className=\"bg-stone-50 p-3 rounded-xl border border-stone-200/40 flex items-center justify-between text-xs text-slate-500 mb-2\">\n                <span className=\"font-medium\">PORTFOLIO RESULTS</span>\n                <span className=\"font-mono text-[10px] bg-[#6A0DAD]/10 text-[#6A0DAD] px-2 py-0.5 rounded-full font-bold\">\n                  {getFilteredArtworks().length} PIECES\n                </span>\n              </div>\n\n              {/* Grid representation */}\n              <div className=\"grid grid-cols-1 gap-5\">\n                {getFilteredArtworks().map((art) => (\n                  <div\n                    key={art.id}\n                    id={`art-item-${art.id}`}\n                    onClick={() => {\n                      setSelectedArtwork(art);\n                      setMenuState(\"artwork-detail\");\n                    }}\n                    className=\"bg-white rounded-2xl border border-stone-200/50 p-3 shadow-xs hover:border-[#6A0DAD]/40 active:scale-[0.99] transition-all cursor-pointer flex flex-col\"\n                  >\n                    {/* Tiny visual thumbnail container */}\n                    <div className=\"w-full aspect-[4/3] rounded-xl overflow-hidden bg-stone-100 flex items-center justify-center relative border border-slate-100 shadow-inner\">\n                      {/* Gradient background preview or real representation overlay */}\n                      <div \n                        className=\"w-full h-full opacity-80\"\n                        style={{\n                          background: `linear-gradient(135deg, ${art.primaryColor}, ${art.secondaryColor}, ${art.tertiaryColor})`\n                        }}\n                      />\n                      {/* Generative icon badge representation */}\n                      <div className=\"absolute inset-x-0 bottom-0 bg-slate-900/60 backdrop-blur-xs p-2 text-white flex justify-between items-center text-[10px]\">\n                        <span className=\"font-mono uppercase tracking-wider\">{art.size}</span>\n                        <span className=\"font-semibold\">{art.category}</span>\n                      </div>\n                    </div>\n\n                    {/* Meta labels */}\n                    <div className=\"pt-3\">\n                      <div className=\"flex justify-between items-start\">\n                        <div>\n                          <h3 className=\"font-semibold text-xs text-slate-800 leading-tight\">{art.title}</h3>\n                          <p className=\"text-[10px] text-slate-400 mt-0.5 font-mono\">{art.artist}</p>\n                        </div>\n                        <span className=\"font-mono text-xs font-bold text-[#6A0DAD] bg-[#6A0DAD]/5 px-2 py-1 rounded\">\n                          ${art.price}\n                        </span>\n                      </div>\n                      \n                      <p className=\"text-[10px] text-slate-500 line-clamp-2 mt-2 leading-relaxed\">\n                        {art.description}\n                      </p>\n\n                      <div className=\"mt-2.5 pt-2 border-t border-stone-100 flex items-center justify-between text-[9px] uppercase tracking-wider text-slate-400 font-semibold font-mono\">\n                        <span>{art.medium.substring(0, 30)}...</span>\n                        <ChevronRight className=\"w-3.5 h-3.5 text-[#6A0DAD]\" />\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n            </div>\n          )}\n\n          {/* PAGE E: EXQUISITE DETAILED 3D CANVAS & PACKAGING OPTIONS */}\n          {menuState === \"artwork-detail\" && selectedArtwork && (\n            <div className=\"space-y-5 py-2 animate-in zoom-in-95 duration-300\">\n              \n              {/* Floating Museum Card detailing the artwork */}\n              <div className=\"bg-white p-4 rounded-2xl border border-stone-200/50 shadow-sm space-y-3\">\n                \n                <div>\n                  <div className=\"flex justify-between items-start\">\n                    <span className=\"px-2 py-0.5 bg-stone-100 border border-stone-200 text-slate-500 font-mono text-[9px] font-bold uppercase tracking-wider rounded\">\n                      {selectedArtwork.style} SELECTION\n                    </span>\n                    <span className=\"font-mono text-xs font-bold text-[#6A0DAD]\">\n                      Dimensions: {selectedArtwork.size}\n                    </span>\n                  </div>\n                  <h3 className=\"text-sm font-bold text-slate-900 tracking-tight mt-1.5\">{selectedArtwork.title}</h3>\n                  <p className=\"text-[10px] font-mono text-[#6A0DAD] tracking-widest uppercase mt-0.5\">{selectedArtwork.artist}</p>\n                </div>\n\n                {/* 3D CANVAS FRAME STAGE SCREEN */}\n                <div className=\"bg-stone-50 rounded-2xl p-2.5 border border-stone-100 relative\">\n                  <ThreeDFrameMockup\n                    artwork={selectedArtwork}\n                    currentFrame={chosenFrame}\n                    onFrameChange={(f) => setChosenFrame(f)}\n                  />\n                </div>\n\n                {/* Description Text block */}\n                <div className=\"space-y-1.5 text-xs text-slate-700 leading-relaxed pt-1.5\">\n                  <p className=\"font-sans text-stone-600\">\n                    {selectedArtwork.description}\n                  </p>\n                  <p className=\"text-[10px] font-mono p-2 bg-stone-50 border border-stone-100 rounded text-slate-500\">\n                    <span className=\"font-semibold uppercase text-slate-700 block mb-0.5\">MEDIUM DETAILS:</span>\n                    {selectedArtwork.medium}\n                  </p>\n                </div>\n\n                {/* Check-Out and Cart inclusion controls */}\n                <div className=\"pt-3 border-t border-stone-100 flex items-center justify-between gap-4\">\n                  <div>\n                    <span className=\"text-[9px] uppercase tracking-widest font-mono text-slate-400 block pb-0.5\">EST. VALUATION</span>\n                    <span className=\"font-mono text-base font-extrabold text-[#6A0DAD]\">${selectedArtwork.price}</span>\n                  </div>\n\n                  <button\n                    id=\"add-to-basket-btn\"\n                    onClick={() => handleAddToBasket(selectedArtwork, chosenFrame)}\n                    className=\"flex-1 bg-slate-950 text-white py-3 px-4 rounded-xl font-semibold hover:bg-slate-800 hover:scale-101 active:scale-97 transition-all flex items-center justify-center gap-2 text-xs shadow-md\"\n                  >\n                    <Plus className=\"w-4 h-4\" />\n                    ADD TO BASKET\n                  </button>\n                </div>\n\n              </div>\n\n            </div>\n          )}\n\n        </main>\n\n        {/* --- BOTTOM FOOTER TAPABLE NAV MENU --- */}\n        <footer className=\"border-t border-stone-200/80 bg-white/90 backdrop-blur pb-6 pt-3 px-6 flex justify-between items-center z-30\">\n          \n          {/* Left Block: Instagram and User Story Icons */}\n          <div className=\"flex items-center gap-4\">\n            \n            {/* Instagram representation launcher */}\n            <button\n              id=\"instagram-logomark\"\n              onClick={() => setInstagramNotice(true)}\n              className=\"p-2 rounded-full hover:bg-stone-50 text-slate-500 hover:text-slate-800 active:scale-95 transition-all text-[#6A0DAD]/70\"\n              title=\"Instagram Page\"\n            >\n              <Instagram className=\"w-5 h-5\" />\n            </button>\n\n            {/* User Story Gradient Circle Tap launcher */}\n            <div \n              id=\"stories-storybox\"\n              onClick={() => setIsStoriesOpen(true)}\n              className=\"relative cursor-pointer flex flex-col items-center\"\n              title=\"Studio Chronicles\"\n            >\n              <div className=\"p-[2px] bg-gradient-to-tr from-[#6A0DAD] via-fuchsia-500 to-amber-500 rounded-full active:scale-95 transition-all\">\n                <div className=\"w-6.5 h-6.5 bg-white rounded-full flex items-center justify-center\">\n                  <User className=\"w-4.5 h-4.5 text-slate-600\" />\n                </div>\n              </div>\n              {/* Pulsing indicator core */}\n              <span className=\"absolute -top-0.5 -right-0.5 w-2 h-2 bg-red-500 rounded-full border border-white animate-ping\" />\n            </div>\n\n          </div>\n\n          {/* Center / right spacing context badge */}\n          <div className=\"text-[9px] font-mono text-slate-400 uppercase tracking-widest hidden xs:block font-bold\">\n            CURATED COLLECTIBLES\n          </div>\n\n          {/* Right Block: Shopping Basket Trigger Indicator mark */}\n          <div>\n            <button\n              id=\"footer-shopping-mark\"\n              onClick={() => setIsBasketOpen(true)}\n              className=\"p-2.5 bg-[#6A0DAD]/5 border border-[#6A0DAD]/10 text-[#6A0DAD] rounded-xl hover:bg-[#6A0DAD]/10 active:scale-95 transition-all flex items-center gap-2 text-xs font-semibold\"\n            >\n              <ShoppingBasket className=\"w-4.5 h-4.5\" />\n              <span className=\"font-mono text-xs\">{basket.length}</span>\n            </button>\n          </div>\n\n        </footer>\n\n        {/* --- OVERLAY 1: CORE AI LOADING CURATION SCREEN --- */}\n        {isCurating && (\n          <div className=\"absolute inset-0 bg-[#FAF9F6] z-50 flex flex-col items-center justify-center p-6 text-center animate-in fade-in duration-300\">\n            <div className=\"relative mb-6\">\n              {/* Outer custom sketched brush circle */}\n              <div className=\"w-16 h-16 border-4 border-dashed border-t-[#6A0DAD] border-[#6A0DAD]/20 rounded-full animate-spin\" />\n              <Sparkles className=\"w-7 h-7 text-amber-500 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 animate-pulse\" />\n            </div>\n\n            <div className=\"space-y-2 max-w-[260px]\">\n              <h3 className=\"font-black text-sm tracking-widest text-[#6A0DAD] uppercase\">\n                AIC Curation System\n              </h3>\n              <p className=\"text-[11px] font-mono text-stone-500 animate-pulse uppercase tracking-wider\">\n                {curationNote}\n              </p>\n              <p className=\"text-[10px] text-slate-400 leading-relaxed pt-2 border-t border-stone-100\">\n                Gemini is dynamically blending high-contrast colors and drafting authentic textures based on your current vibe. Please wait.\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* --- OVERLAY 2: SOCIAL INSTAGRAM MOCK COMPONENT --- */}\n        {instagramNotice && (\n          <div className=\"absolute inset-0 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-6 z-50 animate-in fade-in duration-200\">\n            <div className=\"bg-[#FAF9F6] p-4 rounded-3xl border border-stone-200/50 text-slate-800 text-center max-w-[250px] space-y-3.5 shadow-2xl animate-in zoom-in-95\">\n              <div className=\"w-12 h-12 bg-gradient-to-tr from-amber-500 via-[#6A0DAD] to-indigo-600 rounded-full flex items-center justify-center mx-auto text-white shadow-sm\">\n                <Instagram className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h4 className=\"font-bold text-xs tracking-tight\">ST_CANVAS_STUDIO</h4>\n                <p className=\"text-[10px] font-mono text-slate-400 lowercase mt-0.5\">Exhibition Channel Connected</p>\n              </div>\n              <p className=\"text-[11px] text-stone-600 leading-relaxed\">\n                Thank you for visiting! Tag <span className=\"font-semibold text-slate-900 font-mono\">#StudioCanvas</span> inside your home stories to get featured on our feed panels!\n              </p>\n              <button\n                id=\"close-instagram-notice\"\n                onClick={() => setInstagramNotice(false)}\n                className=\"w-full bg-[#6A0DAD] text-white py-2 rounded-xl text-[10px] uppercase font-bold tracking-wider hover:bg-[#5C0A96] transition-colors\"\n              >\n                CLOSE CHANNEL\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* --- DYNAMIC SLIDE-UP BASKET OVERLAY --- */}\n        <ShoppingBasketDrawer\n          isOpen={isBasketOpen}\n          onClose={() => setIsBasketOpen(false)}\n          items={basket}\n          onRemoveItem={handleRemoveItem}\n          onClearBasket={handleClearBasket}\n        />\n\n        {/* --- DYNAMIC STORIES CAROUSEL MODAL --- */}\n        <UserStoriesModal\n          isOpen={isStoriesOpen}\n          onClose={() => setIsStoriesOpen(false)}\n        />\n\n      </div>\n    </div>\n  );\n}\n\n// Custom internal SVG sketch borders maker component\nfunction HandDrawnBorder() {\n  return (\n    <svg \n      className=\"absolute inset-0 w-full h-full pointer-events-none stroke-[#6A0DAD]\" \n      viewBox=\"0 0 100 100\" \n      preserveAspectRatio=\"none\"\n      fill=\"none\"\n    >\n      {/* Structural sketches */}\n      {/* Top brushstroke */}\n      <path d=\"M 2.5,4 C 33.5,2.5 64.5,4.5 97.5,3 C 96.5,3.2 92,3 88,3\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n      {/* Bottom brushstroke */}\n      <path d=\"M 1.5,96.5 C 31,98 62,95 98.5,96\" strokeWidth=\"2.2\" strokeLinecap=\"round\" />\n      {/* Left brushstroke */}\n      <path d=\"M 3.5,1 C 2,36 3.5,61 2,97.5\" strokeWidth=\"2\" strokeLinecap=\"round\" />\n      {/* Right brushstroke */}\n      <path d=\"M 96.5,2 C 98,34 95,68 97.5,98\" strokeWidth=\"2.3\" strokeLinecap=\"round\" />\n      \n      {/* Sketched outline offsets representing double wire pen passes */}\n      <path d=\"M 5,6 C 36,4.5 58,4.5 95,5.5\" strokeWidth=\"1\" strokeLinecap=\"round\" opacity=\"0.6\" />\n      <path d=\"M 95,4 C 94,36 96,58 94.5,95\" strokeWidth=\"1.2\" strokeLinecap=\"round\" opacity=\"0.65\" />\n      <path d=\"M 95,95 C 58,94 36,95 5,94.2\" strokeWidth=\"1\" strokeLinecap=\"round\" opacity=\"0.6\" />\n      <path d=\"M 6.5,95 T 5.5,5\" strokeWidth=\"1.1\" strokeLinecap=\"round\" opacity=\"0.7\" />\n    </svg>\n  );\n}\n"
